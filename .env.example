# Server-only database for Bingo (development value below is an example only)
DATABASE_URL="postgresql://user:password@localhost:5432/bingo"
# Exact frontend Origin for cookie-authenticated host writes
BINGO_APP_ORIGIN=http://localhost:5173
# Explicit String member UUID grants, independent of String ID admin roles
BINGO_ADMIN_MEMBER_IDS=
PORT=3000
# Optional analytics; auth uses /api and the fixed String ID origin
VITE_GOOGLE_ANALYTICS_ID=

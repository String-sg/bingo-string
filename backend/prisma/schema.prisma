// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String
  picture   String?
  googleId  String?  @unique @map("google_id")
  stringMemberId String? @unique @map("string_member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  games        Game[]

  @@map("users")
}

model Game {
  id             String   @id @default(cuid())
  name           String
  creatorEmail   String?  @map("creator_email")
  creatorId      String   @map("creator_id")
  clientCreateKey String? @unique @map("client_create_key")
  challengesJson Json     @map("challenges_json")
  gridSize       Int      @default(5) @map("grid_size")
  checked        Boolean  @default(false)
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  creator      User          @relation(fields: [creatorId], references: [id])
  gameSessions GameSession[]
  liveRounds   LiveRound[]
  checkedEntries CheckedEntry[]

  @@map("games")
}

model GameSession {
  id           String    @id @default(cuid())
  gameId       String    @map("game_id")
  sessionId    String    @map("session_id")
  playerName   String    @map("player_name")
  progressJson Json      @map("progress_json")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, sessionId])
  @@map("game_sessions")
}

model DefaultGameSession {
  id           String    @id @default(cuid())
  sessionId    String    @unique @map("session_id")
  challengeSet String    @map("challenge_set") // CSV filename used
  gridSize     Int       @default(5) @map("grid_size")
  progressJson Json      @map("progress_json")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("default_game_sessions")
}
model IdentityLinkAudit {
  id String @id @default(cuid())
  userId String @map("user_id")
  stringMemberId String @map("string_member_id")
  method String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("identity_link_audit")
}

model RateLimitBucket {
  key String @id
  hits Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)
  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model LiveRound {
  id        String    @id @default(cuid())
  gameId    String    @map("game_id")
  pin       String    @unique
  demoKey   String?   @unique @map("demo_key")
  closesAt  DateTime  @map("closes_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("live_rounds")
}

model CheckedEntry {
  id          String    @id @default(cuid())
  gameId      String    @map("game_id")
  scope       String
  tokenHash   String    @map("token_hash")
  nickname    String
  tiles       Json      @default("{}")
  win         Json?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  activeAt    DateTime  @default(now()) @map("active_at") @db.Timestamptz(3)
  revision    Int       @default(0)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  attempts    CheckedAction[]

  @@unique([scope, tokenHash])
  @@index([scope, completedAt])
  @@index([activeAt])
  @@index([gameId])
  @@map("checked_entries")
}

model CheckedAction {
  entryId   String       @map("entry_id")
  requestId String       @map("request_id")
  tile      Int?
  outcome   String
  at        DateTime     @default(now()) @db.Timestamptz(3)
  entry     CheckedEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, requestId])
  @@index([entryId, tile, outcome, at])
  @@map("checked_actions")
}

{
    "name": "string-bingo",
    "version": "1.0.0",
    "description": "Interactive String Bingo Game - Complete challenges and get BINGO!",
    "main": "index.html",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "deploy": "npm run build && gh-pages -d dist",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "postinstall": "prisma generate --schema=./backend/prisma/schema.prisma",
        "test:backend": "tsx --test tests/backend/*.test.ts",
        "check:backend": "tsc -p backend/tsconfig.json --noEmit",
        "check:startup": "tsx -e \"process.env.VERCEL='1'; import('./api/index.ts').then(() => console.log('API imported'))\""
    },
    "keywords": [
        "bingo",
        "game",
        "string",
        "interactive",
        "challenges"
    ],
    "engines": {
        "node": "^22.12.0"
    },
    "author": "String Team",
    "license": "MIT",
    "dependencies": {
        "@playwright/test": "^1.56.0",
        "@prisma/client": "^5.7.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "tsx": "^4.6.2",
        "typescript": "^5.3.3",
        "vite": "^6.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.5",
        "gh-pages": "^6.0.0",
        "prisma": "^5.7.1",
        "rollup": "4.59.0"
    }
}

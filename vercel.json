{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/play/:path*",
            "destination": "/play.html"
        },
        {
            "source": "/:email([^/]+(?:@|%40)[^/]+)/:gameId",
            "destination": "/play.html"
        }
    ],
    "functions": {
        "api/index.ts": {
            "maxDuration": 10
        }
    }
}
